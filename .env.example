COMPANY_NAME="Nautic Controls"
SITE_NAME="Nautic Controls"
# myshopify subdomain only, no brackets, no https://
SHOPIFY_STORE_DOMAIN="your-store.myshopify.com"
# Headless channel public Storefront API token (browser-safe; also OK server-side)
SHOPIFY_STOREFRONT_ACCESS_TOKEN=""
# Optional Headless channel private token (server-only). Preferred when set.
# Cart/checkout calls send Shopify-Storefront-Buyer-IP with this token.
SHOPIFY_STOREFRONT_PRIVATE_TOKEN=""
# Shared secret for /api/revalidate webhooks (?secret=...)
SHOPIFY_REVALIDATION_SECRET=""

# Storefront API version is pinned in lib/constants.ts (SHOPIFY_STOREFRONT_API_VERSION).
# Watch Hydrogen framework-agnostic preview (not production yet): docs/hydrogen-preview-watch.md

